---
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const notes = (await getCollection('notes', ({ data }) => !data.draft))
    .sort((a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf());
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, number: notes.length - i },
  }));
}

type Props = { note: CollectionEntry<'notes'>; number: number };
const { note, number } = Astro.props;
const { Content } = await render(note);

const fmt = (d: Date) =>
  d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });

const canonical = new URL(`/notes/${note.id}/`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: note.data.title,
  description: note.data.ringkasan,
  datePublished: note.data.tanggal.toISOString(),
  url: canonical,
  mainEntityOfPage: canonical,
  inLanguage: 'id-ID',
  author: {
    '@type': 'Person',
    name: 'Ahmad Ilham',
    url: 'https://ahmadilham.dev',
  },
  publisher: {
    '@type': 'Organization',
    name: 'C# Indonesia',
    url: 'https://csharp-indonesia.com',
  },
  ...(note.data.sumber && { isBasedOn: note.data.sumber }),
  ...(note.data.topik && { keywords: note.data.topik }),
};
---

<Base
  title={`${note.data.title} — C# Indonesia`}
  description={note.data.ringkasan}
  type="article"
  publishedTime={note.data.tanggal.toISOString()}
  jsonLd={jsonLd}
>
  <main class="wrap note">
    <a class="back" href="/#catatan">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="M11 18l-6-6 6-6" /></svg>
      Semua catatan
    </a>

    <article>
      <header class="note-head">
        <p class="note-meta">
          <span>No. {String(number).padStart(2, '0')}</span>
          <span class="note-topic">{note.data.topik}</span>
          <time datetime={note.data.tanggal.toISOString()}>{fmt(note.data.tanggal)}</time>
        </p>
        <h1 class="note-title">{note.data.title}</h1>
        <p class="note-stand">{note.data.ringkasan}</p>
      </header>

      <div class="note-body">
        <Content />
      </div>

      {note.data.sumber && (
        <p class="note-source">
          Referensi: <a href={note.data.sumber} rel="noopener">{note.data.sumber}</a>
        </p>
      )}
    </article>
  </main>

  <style>
    .note { padding-top: 3rem; padding-bottom: 5rem; max-width: 820px; }

    .back {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 44px;
      font-family: var(--mono);
      font-size: 0.8125rem;
      color: var(--muted);
      margin-bottom: 1.5rem;
    }
    .back:hover { color: var(--ink); text-decoration: none; }

    .note-head {
      padding-bottom: 2rem;
      margin-bottom: 2.25rem;
      border-bottom: 1px solid var(--rule);
    }
    .note-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--muted);
    }
    .note-topic { color: var(--accent-text); }
    .note-title {
      margin: 0 0 1.25rem;
      font-size: clamp(2rem, 4.6vw, 3rem);
      line-height: 1.08;
      letter-spacing: -0.035em;
      font-weight: 600;
    }
    .note-stand {
      max-width: var(--measure);
      font-size: 1.1875rem;
      line-height: 1.6;
      color: var(--muted);
    }

    /* prose */
    .note-body { font-size: 1.0625rem; line-height: 1.65; color: var(--body); }
    .note-body :global(p) { margin: 1.25rem 0; max-width: var(--measure); }
    .note-body :global(h2) {
      margin: 2.75rem 0 0.75rem;
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: -0.025em;
      line-height: 1.25;
      color: var(--ink);
    }
    .note-body :global(h3) {
      margin: 2rem 0 0.5rem;
      font-size: 1.1875rem;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--ink);
    }
    .note-body :global(ul),
    .note-body :global(ol) { margin: 1.25rem 0; padding-left: 1.4rem; max-width: var(--measure); }
    .note-body :global(li) { margin: 0.5rem 0; }
    .note-body :global(li)::marker { color: var(--muted); }
    .note-body :global(blockquote) {
      margin: 1.75rem 0;
      padding: 1.25rem 1.5rem;
      max-width: var(--measure);
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 14px;
      color: var(--muted);
    }
    .note-body :global(blockquote p) { margin: 0.5rem 0; }
    .note-body :global(blockquote p:first-child) { margin-top: 0; }
    .note-body :global(blockquote p:last-child) { margin-bottom: 0; }
    .note-body :global(strong) { color: var(--ink); font-weight: 600; }
    .note-body :global(hr) {
      border: 0;
      border-top: 1px solid var(--rule);
      margin: 2.5rem 0;
      max-width: var(--measure);
    }

    .note-source {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--rule);
      font-family: var(--mono);
      font-size: 0.8125rem;
      color: var(--muted);
      max-width: var(--measure);
      overflow-wrap: anywhere;
    }
  </style>
</Base>
